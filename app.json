{
  "expo": {
    "name": "FreeCompass",
    "slug": "freecompass",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f14"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FreeCompass uses your GPS to display your precise latitude, longitude, and elevation.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FreeCompass uses your GPS to display your precise latitude, longitude, and elevation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f14"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "package": "com.paigejulianne.freecompass"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FreeCompass uses your GPS to display your precise latitude, longitude, and elevation."
        }
      ],
      "expo-asset"
    ]
  }
}
